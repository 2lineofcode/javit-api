DMM_API_ID=
DMM_AFFILIATE_ID=
# Optional comma-separated, exact CDN hostnames trusted by the administrator.
PROXY_ALLOWED_HOSTS=
# Optional Chrome DevTools endpoint for a server without a desktop browser.
# Local macOS/Windows uses an installed Google Chrome when MissAV requires verification.
SCRAPER_BROWSER_URL=
# Optional comma-separated hostnames allowed to access the development server.
# Use hostnames without a scheme or port, e.g. dev.example.com,*.dev.example.com.
DEV_ALLOWED_ORIGINS=
